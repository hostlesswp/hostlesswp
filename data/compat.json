  },
  {
   "feature": "HTTP from plugins (curl, file_get_contents of URLs)",
   "status": "works",
   "note": "curl_*() and http(s):// streams send through the Worker's fetch(); curl_multi requests run in parallel. Requests time out after 30 s."
  },
  {
   "feature": "PHP sessions ($_SESSION)",
   "status": "works",
   "note": "Kept in your database (table <prefix>hostlesswp_sessions, created on first use), so they survive across Worker instances."
  },
  {
   "feature": "Raw sockets (fsockopen, stream_socket_client)",
   "status": "works",
   "note": "Real TCP connections from the Worker, TLS included. Port 25 and Cloudflare IP addresses are not reachable from Workers."
  },
  {
   "feature": "AVIF image uploads",
   "status": "works",
   "note": "The sizes WordPress makes from them are saved as WebP: GD decodes AVIF but cannot encode it. Works up to 2560x1920."
  },
  {
   "feature": "Very large image uploads",
   "status": "no",
   "note": "GD holds the whole image in memory: JPEG works at 3000x2000 and fails at 4000x3000. Resize photos before uploading."
